GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: disable AI SDK warning logs (e.g. specificationVersion compatibility)
# AI_SDK_LOG_WARNINGS=false

# Rate limiting (requires Upstash Redis)
# Get URLs from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: customize rate limit (default: 20 requests per 1 hour)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1 h
